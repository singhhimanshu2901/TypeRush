rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Private User Profile Documents
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);

      // Client updates restricted: Clients can only modify non-privileged fields (displayName, photoURL, equippedCarId)
      // Privileged fields (xp, level, wins, totalRaces, bestWpm) cannot be directly inflated by client updates
      allow update: if isOwner(uid) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'equippedCarId', 'updatedAt']) ||
        (
          request.resource.data.xp == resource.data.xp &&
          request.resource.data.level == resource.data.level &&
          request.resource.data.wins == resource.data.wins
        )
      );

      // Subcollection of User Race Records (Immutable once written)
      match /races/{raceId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          request.resource.data.netWpm >= 0 &&
          request.resource.data.accuracy >= 0 &&
          request.resource.data.accuracy <= 100;
        allow update, delete: if false; // Replay / overwrite protection
      }
    }

    // Public Leaderboard Records (Excludes PII/Email)
    match /leaderboards/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && !('email' in request.resource.data);
    }

    // Multiplayer Rooms
    match /multiplayerRooms/{roomCode} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;

      // Host immutability: Host UID cannot be hijacked by other players
      allow update: if isSignedIn() &&
        request.resource.data.hostUid == resource.data.hostUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'status', 'lastActiveAt', 'passage', 'difficulty']);

      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}
