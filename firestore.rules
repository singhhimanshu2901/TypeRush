rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Private User Profiles
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) &&
        request.resource.data.xp >= 0 &&
        request.resource.data.level >= 1;

      // User Race Records (Immutable)
      match /races/{raceId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) &&
          request.resource.data.netWpm >= 0 &&
          request.resource.data.accuracy >= 0 &&
          request.resource.data.accuracy <= 100;
        allow update, delete: if false;
      }
    }

    // Public Leaderboards (No email PII)
    match /leaderboards/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) && !('email' in request.resource.data);
    }

    // Multiplayer Rooms
    match /multiplayerRooms/{roomCode} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update: if isSignedIn() &&
        request.resource.data.hostUid == resource.data.hostUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'status', 'lastActiveAt', 'passage', 'difficulty']);
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;
    }
  }
}
